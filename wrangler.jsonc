{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "noodle-distribution",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "noodle-distribution" }],
  // Delivery photos (staff-only) and product images (public), served by app/files/[...key]/route.ts.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "noodle-files" }]
}
