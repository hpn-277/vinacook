{
  "name": "noodle-distribution",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @noodle/api --filter @noodle/web run dev",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm --filter @noodle/web run lint",
    "env": "node scripts/env.mjs",
    "gen:types": "supabase gen types typescript --local > packages/core/src/database.types.ts",
    "e2e": "pnpm --filter @noodle/web run e2e",
    "seed:history": "psql postgresql://postgres:postgres@127.0.0.1:54322/postgres -q -f scripts/seed-history.sql",
    "deploy": "pnpm --filter @noodle/api run deploy && pnpm --filter @noodle/web run deploy",
    "smoke": "pnpm --filter @noodle/web run smoke"
  },
  "devDependencies": {
    "supabase": "^2.120.0",
    "typescript": "^5"
  }
}
